---
import { site, whatsappHref, hasWhatsApp } from '@/content/site';
const wa = whatsappHref();
---

<header class="site-header" data-scrolled="false">
  <div class="site-header-inner container-x">
    <a class="brand" href="#navigator" aria-label={`${site.name} — back to top`}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="site-actions">
      <a class="site-contact" href={site.contactHref}>Contact</a>
      <a
        class="btn btn-primary site-whatsapp"
        href={wa}
        target={hasWhatsApp ? '_blank' : undefined}
        rel="noopener"
        data-placeholder={hasWhatsApp ? undefined : 'true'}
      >
        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
          <path d="M8 1.5a6.5 6.5 0 0 0-5.6 9.8L1.5 14.5l3.3-.9A6.5 6.5 0 1 0 8 1.5Zm0 1.2a5.3 5.3 0 1 1-2.7 9.9l-.2-.1-2 .5.5-1.9-.1-.2A5.3 5.3 0 0 1 8 2.7Zm-2 2.6c-.1 0-.4 0-.6.3-.2.2-.8.8-.8 1.9s.8 2.2.9 2.3c.1.2 1.6 2.5 3.9 3.4 1.9.8 2.3.6 2.7.6.4 0 1.3-.5 1.5-1.1.2-.5.2-1 .1-1.1l-.4-.2-1.5-.7c-.2-.1-.3-.1-.5.1l-.7.8c-.1.2-.3.2-.5.1-.2-.1-.9-.3-1.7-1.1-.6-.6-1-1.3-1.2-1.5-.1-.2 0-.3.1-.4l.3-.4.2-.4v-.4l-.7-1.6c-.2-.4-.3-.4-.5-.4H6Z"/>
        </svg>
        WhatsApp
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    let ticking = false;
    const update = () => {
      header.dataset.scrolled = window.scrollY > 24 ? 'true' : 'false';
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>
